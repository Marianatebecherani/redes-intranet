# Configuração do docker-compose.yml. Copie para .env e troque todos os valores "troque-...".
# O arquivo .env não é versionado.

# Banco de dados (MySQL)
MYSQL_ROOT_PASSWORD=troque-a-senha-root
MYSQL_DATABASE=intranet
MYSQL_USER=intranet
MYSQL_PASSWORD=troque-a-senha-da-aplicacao

# Segredo de assinatura do login, compartilhado pelas três réplicas (mínimo de 32 caracteres).
# Exemplo para gerar: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=8h
# Use true quando o nginx servir a intranet por HTTPS.
COOKIE_SECURE=false

# Tamanho máximo de cada arquivo enviado, em MB (ajuste também o client_max_body_size do nginx).
UPLOAD_MAX_MB=100

# Endereço em que as portas 3001-3003 são publicadas no host.
# 127.0.0.1 deixa as réplicas acessíveis apenas pelo nginx da própria máquina.
APP_BIND_ADDRESS=127.0.0.1

# Pastas compartilhadas no host. Na EC2, use os caminhos reais:
# SHARE_ADMIN_HOST_DIR=/compartilhamento/admin
# SHARE_GERAL_HOST_DIR=/compartilhamento/geral
SHARE_ADMIN_HOST_DIR=./compartilhamento/admin
SHARE_GERAL_HOST_DIR=./compartilhamento/geral
