# Configuração para executar o backend fora do Docker (npm run dev).
# Copie para .env e ajuste os valores. Use apenas valores fictícios neste arquivo.

PORT=3000
INSTANCE_NAME=local

DB_HOST=localhost
DB_PORT=3306
DB_USER=intranet
DB_PASSWORD=troque-esta-senha
DB_NAME=intranet

# Segredo de assinatura dos tokens; mínimo de 32 caracteres e igual em todas as réplicas.
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=8h
# Use true quando a intranet for acessada por HTTPS.
COOKIE_SECURE=false

# Caminhos relativos são resolvidos a partir da pasta backend/.
SHARE_ADMIN_DIR=../compartilhamento/admin
SHARE_GERAL_DIR=../compartilhamento/geral
UPLOAD_MAX_MB=100

STATIC_DIR=../frontend/dist
